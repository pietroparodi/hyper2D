! Hyper2D input file

Timestep:
    1e-6

Number_of_timesteps:
    10000

Max_timestep:
   1.0e-2

Target_CFL:
   0.25

Stats_every:
   1

Output_path:
./dumps_coupled/

Binary_output:
   .TRUE.

Dump_state_every:
   10000

Species_file:
iodine.species
   
Number_fluid_species:
   2

Def_mixture:
   Initial   I 0.5   I2 0.5

Initial_state:
   Initial   9.6573e20   0.0   0.0   0.0   300.0

Flux_function:
   AUSM


Axisymmetric:
   .FALSE.

!Wall_reactions_file:
!iodine.wall
   
Reactions_file:
iodine.react

Mesh_file_SU2:
testgrid_box2.su2

!Background_file:
!background_box_laptop.vtk

Boundary_condition:
   Left   kinetic   300.0    0.0 0.0

Boundary_condition:
   Down   kinetic   300.0   0.0 0.0

Boundary_condition:
   Right   kinetic   300.0   0.0 0.0

Boundary_condition:
   Up   kinetic   300.0   100.0 0.0

!Boundary_condition:
!   Left   noslip   300.0

!Boundary_condition:
!   Down   noslip   300.0

!Boundary_condition:
!   Right   noslip   300.0

!Boundary_condition:
!   Up   moving   300.0   100.0 0.0

